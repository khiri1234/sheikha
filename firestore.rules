rules_version = '2';

// Sheikha Textiles POS – Firestore security rules.
// The head-office login below must match HQ_EMAIL in index.html.
// Publish these rules in Firebase console → Firestore Database → Rules.
//
// Who can do what:
//   head office  – everything: settings, fabrics, branches, purchases, all branches' data
//   branch login – read settings and fabrics; read and add its own branch's
//                  sales, held bills, shifts and log; void (never delete)
//                  or edit its sales (Edit Bill); a closed shift (Z report) can't be changed
//   anyone else  – nothing
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isHQ() { return signedIn() && email() == 'sheikhatextiles@gmail.com'; }
    function loginDoc() { return /databases/$(database)/documents/branchLogins/$(email()); }
    function isBranch(b) { return signedIn() && exists(loginDoc()) && get(loginDoc()).data.branch == b; }
    function isStaff() { return isHQ() || (signedIn() && exists(loginDoc())); }

    // shop settings (config/shop) and VAT 201 inputs (config/vatin) are read by the tills;
    // the head-office phones (config/devices) and notification settings (config/notify)
    // are for head office only
    match /config/{doc} {
      allow read: if isHQ() || (isStaff() && doc in ['shop', 'vatin']);
      allow write: if isHQ();
    }

    // shared fabric list
    match /items/{id} {
      allow read: if isStaff();
      allow write: if isHQ();
    }

    // which branch each login belongs to
    match /branchLogins/{em} {
      allow read: if isHQ() || (signedIn() && email() == em);
      allow write: if isHQ();
    }

    // customers' phone numbers (for offers): a till can look up one number and add a visit,
    // but can't list, download or delete customers; head office manages the list
    match /customers/{id} {
      allow list, delete: if isHQ();
      allow get: if isStaff();
      allow create: if isHQ() || (isStaff() && id.matches('^9715[0-9]{8}$')
        && request.resource.data.phone == id
        && request.resource.data.keys().hasOnly(['phone', 'name', 'lastAt', 'lastBranch', 'visits', 'spent',
             'consent', 'consentAt', 'consentBy', 'consentBranch', 'firstAt', 'firstBranch'])
        && request.resource.data.visits == 1
        && request.resource.data.get('consent', 'no') in ['agreed', 'no']);
      allow update: if isHQ() || (isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastAt', 'lastBranch', 'visits', 'spent',
             'consent', 'consentAt', 'consentBy', 'consentBranch'])
        && request.resource.data.visits == resource.data.get('visits', 0) + 1
        && request.resource.data.spent >= resource.data.get('spent', 0)
        && request.resource.data.get('consent', 'no') in ['agreed', resource.data.get('consent', 'no')]);
    }

    // supplier bills (Purchases), head office only
    match /purchases/{id} {
      allow read, write: if isHQ();
    }

    // head office activity log
    match /hqlog/{id} {
      allow read, create: if isHQ();
    }

    match /branches/{b} {
      allow read: if isHQ() || isBranch(b);
      allow write: if isHQ();

      // sales can be added, voided, and edited by their branch (Edit Bill) – never deleted.
      // An edit keeps the invoice number, date and branch, and stores the old version in "edits".
      match /sales/{id} {
        allow read: if isHQ() || isBranch(b);
        allow create: if isBranch(b) && request.resource.data.branch == b
          && request.resource.data.status == 'paid';
        allow update: if (isHQ() || isBranch(b))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidedAt', 'voidedBy'])
          && request.resource.data.status == 'void';
        allow update: if isBranch(b) && resource.data.status == 'paid'
          && request.resource.data.status == 'paid'
          && request.resource.data.branch == b
          && resource.data.get('kind', '') != 'return'
          && request.resource.data.get('kind', '') == resource.data.get('kind', '')
          && request.resource.data.no == resource.data.no
          && request.resource.data.ts == resource.data.ts
          && request.resource.data.edits.size() == resource.data.get('edits', []).size() + 1
          && request.resource.data.edits.hasAll(resource.data.get('edits', []));
      }

      match /held/{id} {
        allow read: if isHQ() || isBranch(b);
        allow write: if isBranch(b);
      }

      match /logs/{id} {
        allow read: if isHQ() || isBranch(b);
        allow create: if isBranch(b) && request.resource.data.branch == b;
      }

      // shifts: opened with the cash float, closed once with the cash count (Z report);
      // a closed shift can't be changed
      match /shifts/{id} {
        allow read: if isHQ() || isBranch(b);
        allow create: if isBranch(b) && request.resource.data.branch == b && request.resource.data.status == 'open';
        // while open: the float, opening time and branch can't be changed, and petty cash
        // movements can only be added, never changed or removed
        allow update: if isBranch(b) && resource.data.status == 'open'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'branch', 'openingFloat', 'openedAt', 'openedBy'])
          && request.resource.data.get('moves', []).hasAll(resource.data.get('moves', []));
      }

      // invoice, held-bill and Z-report counters: they only ever go up, so an invoice or
      // Z-report number can't be handed out twice
      match /meta/{id} {
        allow read: if isHQ() || isBranch(b);
        allow create: if isBranch(b);
        allow update: if isBranch(b)
          && request.resource.data.get('invNext', 0) >= resource.data.get('invNext', 0)
          && request.resource.data.get('heldSeq', 0) >= resource.data.get('heldSeq', 0)
          && request.resource.data.get('zSeq', 0) >= resource.data.get('zSeq', 0);
      }
    }
  }
}
