rules_version = '2';

// Sheikha Textiles POS – Firestore security rules.
// The head-office login below must match HQ_EMAIL in index.html.
// Publish these rules in Firebase console → Firestore Database → Rules.
//
// Who can do what:
//   head office  – everything: settings, fabrics, branches, purchases, all branches' data
//   branch login – read settings and fabrics; read and add its own branch's
//                  sales, held bills, shifts and log; void (not edit or delete)
//                  its sales; a closed shift (Z report) can't be changed
//   anyone else  – nothing
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isHQ() { return signedIn() && email() == 'sheikhatextiles@gmail.com'; }
    function loginDoc() { return /databases/$(database)/documents/branchLogins/$(email()); }
    function isBranch(b) { return signedIn() && exists(loginDoc()) && get(loginDoc()).data.branch == b; }
    function isStaff() { return isHQ() || (signedIn() && exists(loginDoc())); }

    // shop settings (config/shop) and VAT 201 inputs (config/vatin)
    match /config/{doc} {
      allow read: if isStaff();
      allow write: if isHQ();
    }

    // shared fabric list
    match /items/{id} {
      allow read: if isStaff();
      allow write: if isHQ();
    }

    // which branch each login belongs to
    match /branchLogins/{em} {
      allow read: if isHQ() || (signedIn() && email() == em);
      allow write: if isHQ();
    }

    // supplier bills (Purchases), head office only
    match /purchases/{id} {
      allow read, write: if isHQ();
    }

    // head office activity log
    match /hqlog/{id} {
      allow read, create: if isHQ();
    }

    match /branches/{b} {
      allow read: if isHQ() || isBranch(b);
      allow write: if isHQ();

      // sales can be added and voided, never edited or deleted
      match /sales/{id} {
        allow read: if isHQ() || isBranch(b);
        allow create: if isBranch(b) && request.resource.data.branch == b;
        allow update: if (isHQ() || isBranch(b))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidedAt', 'voidedBy'])
          && request.resource.data.status == 'void';
      }

      match /held/{id} {
        allow read: if isHQ() || isBranch(b);
        allow write: if isBranch(b);
      }

      match /logs/{id} {
        allow read: if isHQ() || isBranch(b);
        allow create: if isBranch(b);
      }

      // shifts: opened with the cash float, closed once with the cash count (Z report);
      // a closed shift can't be changed
      match /shifts/{id} {
        allow read: if isHQ() || isBranch(b);
        allow create: if isBranch(b) && request.resource.data.branch == b && request.resource.data.status == 'open';
        allow update: if isBranch(b) && resource.data.status == 'open';
      }

      // invoice, held-bill and Z-report counters
      match /meta/{id} {
        allow read: if isHQ() || isBranch(b);
        allow write: if isBranch(b);
      }
    }
  }
}
